<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block direct web access to hidden files and sensitive project files (.env, .git, etc.)
    RewriteRule (^|/)\. - [F,L]

    # Allow direct access to public/ directory for public endpoints and assets
    RewriteRule ^public/ - [L]

    # Route all clean requests through the Laravel public directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
